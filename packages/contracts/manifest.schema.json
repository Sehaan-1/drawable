{
  "$defs": {
    "CheckpointProvenance": {
      "additionalProperties": false,
      "description": "One pinned model artifact, as verified by the pipeline that used it.\n\n``status`` is the whole point: ``verified`` means the bytes matched a\npublished digest, ``recorded`` means the digest was captured on first use\nbecause the publisher exposes none, ``revision`` means only a repository\ncommit pinned it, and ``unchecked`` means verification was switched off.\nA dataset that quietly mixed those three is the failure this file exists to\nprevent, so the difference is written down per artifact.",
      "properties": {
        "group": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Group",
          "type": "string"
        },
        "id": {
          "maxLength": 128,
          "minLength": 3,
          "title": "Id",
          "type": "string"
        },
        "locator": {
          "maxLength": 512,
          "title": "Locator",
          "type": "string"
        },
        "pinned": {
          "title": "Pinned",
          "type": "boolean"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "size_bytes": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Size Bytes"
        },
        "status": {
          "enum": [
            "verified",
            "recorded",
            "revision",
            "unchecked"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "id",
        "group",
        "locator",
        "status",
        "pinned"
      ],
      "title": "CheckpointProvenance",
      "type": "object"
    },
    "CropBox": {
      "additionalProperties": false,
      "description": "Crop coordinates in source-image pixel space (inclusive-exclusive).",
      "properties": {
        "height": {
          "exclusiveMinimum": 0,
          "title": "Height",
          "type": "integer"
        },
        "width": {
          "exclusiveMinimum": 0,
          "title": "Width",
          "type": "integer"
        },
        "x": {
          "minimum": 0,
          "title": "X",
          "type": "integer"
        },
        "y": {
          "minimum": 0,
          "title": "Y",
          "type": "integer"
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "title": "CropBox",
      "type": "object"
    },
    "DatasetSplit": {
      "description": "Split assignment. Assets derived from one source work never cross splits.",
      "enum": [
        "train",
        "validation",
        "test",
        "gallery_only"
      ],
      "title": "DatasetSplit",
      "type": "string"
    },
    "HumanReview": {
      "additionalProperties": false,
      "properties": {
        "malformed_anatomy": {
          "default": false,
          "title": "Malformed Anatomy",
          "type": "boolean"
        },
        "note": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "poor_extraction": {
          "default": false,
          "title": "Poor Extraction",
          "type": "boolean"
        },
        "quality": {
          "anyOf": [
            {
              "enum": [
                1,
                2,
                3
              ],
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quality"
        },
        "state": {
          "$ref": "#/$defs/ReviewState",
          "default": "unreviewed"
        }
      },
      "title": "HumanReview",
      "type": "object"
    },
    "LineArtOrigin": {
      "description": "Whether the visible reference is native line art or machine-extracted.",
      "enum": [
        "native_line_art",
        "extracted_line_art"
      ],
      "title": "LineArtOrigin",
      "type": "string"
    },
    "ManifestRecord": {
      "additionalProperties": false,
      "description": "One gallery or training asset. See the spec's \"Manifest schema\" list.",
      "properties": {
        "asset_id": {
          "pattern": "^ls_[a-z0-9]{2,16}_[a-f0-9]{16}$",
          "title": "Asset Id",
          "type": "string"
        },
        "crop": {
          "anyOf": [
            {
              "$ref": "#/$defs/CropBox"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "enabled": {
          "title": "Enabled",
          "type": "boolean"
        },
        "extraction_model": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Extraction Model"
        },
        "extraction_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Extraction Sha256"
        },
        "extraction_version": {
          "anyOf": [
            {
              "maxLength": 32,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Extraction Version"
        },
        "height": {
          "exclusiveMinimum": 0,
          "title": "Height",
          "type": "integer"
        },
        "ink_coverage": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Ink Coverage",
          "type": "number"
        },
        "license_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "License Id",
          "type": "string"
        },
        "line_art_checksum": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Line Art Checksum",
          "type": "string"
        },
        "line_art_path": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Line Art Path",
          "type": "string"
        },
        "origin": {
          "$ref": "#/$defs/LineArtOrigin"
        },
        "original_path": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Original Path",
          "type": "string"
        },
        "person_count": {
          "anyOf": [
            {
              "maximum": 50,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Person Count"
        },
        "phash": {
          "pattern": "^[a-f0-9]{16}$",
          "title": "Phash",
          "type": "string"
        },
        "pipeline_version": {
          "maxLength": 32,
          "minLength": 1,
          "title": "Pipeline Version",
          "type": "string"
        },
        "primary_style": {
          "$ref": "#/$defs/PrimaryStyle"
        },
        "quality_score": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Quality Score",
          "type": "number"
        },
        "review": {
          "$ref": "#/$defs/HumanReview"
        },
        "scopes": {
          "items": {
            "$ref": "#/$defs/ScopeLabel"
          },
          "minItems": 1,
          "title": "Scopes",
          "type": "array"
        },
        "sfw": {
          "$ref": "#/$defs/SfwDecision"
        },
        "source_checksum": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Source Checksum",
          "type": "string"
        },
        "source_dataset": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Source Dataset",
          "type": "string"
        },
        "source_item_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Source Item Id",
          "type": "string"
        },
        "source_url": {
          "anyOf": [
            {
              "maxLength": 2048,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Url"
        },
        "source_work_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Source Work Id",
          "type": "string"
        },
        "split": {
          "$ref": "#/$defs/DatasetSplit"
        },
        "text_coverage": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Text Coverage",
          "type": "number"
        },
        "thumbnail_checksum": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Thumbnail Checksum",
          "type": "string"
        },
        "thumbnail_path": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Thumbnail Path",
          "type": "string"
        },
        "width": {
          "exclusiveMinimum": 0,
          "title": "Width",
          "type": "integer"
        }
      },
      "required": [
        "asset_id",
        "source_dataset",
        "source_item_id",
        "source_work_id",
        "license_id",
        "original_path",
        "line_art_path",
        "thumbnail_path",
        "origin",
        "primary_style",
        "scopes",
        "sfw",
        "width",
        "height",
        "text_coverage",
        "ink_coverage",
        "phash",
        "quality_score",
        "split",
        "enabled",
        "pipeline_version",
        "source_checksum",
        "line_art_checksum",
        "thumbnail_checksum"
      ],
      "title": "ManifestRecord",
      "type": "object"
    },
    "PipelineProvenance": {
      "additionalProperties": false,
      "description": "Which code, environment, and weights produced this gallery.\n\nIdentity only \u2014 no timestamps, because ``Manifest.content_hash()`` keys the\nderived indexes and must not move when nothing but the clock did.",
      "properties": {
        "checkpoint_policy": {
          "default": "record",
          "enum": [
            "strict",
            "record",
            "off"
          ],
          "title": "Checkpoint Policy",
          "type": "string"
        },
        "checkpoints": {
          "items": {
            "$ref": "#/$defs/CheckpointProvenance"
          },
          "maxItems": 64,
          "title": "Checkpoints",
          "type": "array"
        },
        "environment_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Environment Sha256"
        },
        "model_lock_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Lock Sha256"
        },
        "pipeline_version": {
          "default": "colab-m2-1",
          "maxLength": 32,
          "minLength": 1,
          "title": "Pipeline Version",
          "type": "string"
        },
        "runtime": {
          "additionalProperties": {
            "maxLength": 64,
            "type": "string"
          },
          "maxProperties": 64,
          "title": "Runtime",
          "type": "object"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "source_action": {
          "anyOf": [
            {
              "enum": [
                "cloned",
                "reused",
                "fetched",
                "failed"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Action"
        },
        "source_dirty": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Dirty"
        },
        "source_repo": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Repo"
        },
        "source_revision": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{40}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Revision"
        }
      },
      "title": "PipelineProvenance",
      "type": "object"
    },
    "PrimaryStyle": {
      "description": "Exactly one primary style per asset. Also the five reference-panel rows.",
      "enum": [
        "manga_anime",
        "western_ink",
        "realistic_academic",
        "cartoon",
        "gesture_sketch"
      ],
      "title": "PrimaryStyle",
      "type": "string"
    },
    "ReviewState": {
      "description": "Human curation state for an asset.",
      "enum": [
        "unreviewed",
        "accepted",
        "rejected",
        "quarantined"
      ],
      "title": "ReviewState",
      "type": "string"
    },
    "ScopeLabel": {
      "description": "What part of a character (or how many characters) an image depicts.\n\nAn asset may carry several scope labels; queries return one probability per\nlabel plus ``unknown``.",
      "enum": [
        "eye",
        "eyebrow",
        "mouth",
        "face_head",
        "hair",
        "hand",
        "foot",
        "upper_body_clothing",
        "full_body",
        "multi_character",
        "unknown"
      ],
      "title": "ScopeLabel",
      "type": "string"
    },
    "SfwDecision": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "method": {
          "enum": [
            "source_rating",
            "opennsfw2",
            "source_rating+opennsfw2",
            "manual"
          ],
          "title": "Method",
          "type": "string"
        },
        "safe": {
          "title": "Safe",
          "type": "boolean"
        }
      },
      "required": [
        "safe",
        "confidence",
        "method"
      ],
      "title": "SfwDecision",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A versioned collection of records plus the dataset/index version stamp.",
  "properties": {
    "dataset_version": {
      "pattern": "^\\d{4}\\.\\d{2}\\.\\d{2}(-[a-z0-9]+)?$",
      "title": "Dataset Version",
      "type": "string"
    },
    "provenance": {
      "anyOf": [
        {
          "$ref": "#/$defs/PipelineProvenance"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "records": {
      "items": {
        "$ref": "#/$defs/ManifestRecord"
      },
      "title": "Records",
      "type": "array"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "dataset_version",
    "records"
  ],
  "title": "Manifest",
  "type": "object"
}
